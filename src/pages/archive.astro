---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveTimeline from '../components/astro/ArchiveTimeline.astro';
import { getAllPublishedPosts, type PostMeta } from '../lib/notion';

const posts = await getAllPublishedPosts();

// 按发布年份分组（Notion 返回顺序已是日期倒序，组内保持倒序）
const UNDATED = '未标注日期';
const groupMap = new Map<string, PostMeta[]>();
for (const post of posts) {
  const year = post.publishedAt ? post.publishedAt.slice(0, 4) : UNDATED;
  const list = groupMap.get(year) ?? [];
  list.push(post);
  groupMap.set(year, list);
}

const groups = [...groupMap.entries()].map(([year, groupPosts]) => ({
  year,
  posts: groupPosts,
}));
// 年份倒序；未标注日期的组排最后
groups.sort((a, b) => {
  if (a.year === UNDATED) return 1;
  if (b.year === UNDATED) return -1;
  return b.year.localeCompare(a.year);
});
---

<BaseLayout title="归档 · Holy Night" view="archive">
  <main class="archive-wrap">
    <header class="archive-head">
      <h1>归 档</h1>
      <div class="archive-head-ribbon">
        <span class="ribbon">ARCHIVE</span>
      </div>
      <div class="archive-img">
        <img
          src="/backgrounds/bg-clouds.jpg"
          alt="云隙光下的三咲町"
          width="560"
          height="240"
          loading="lazy"
        />
      </div>
    </header>
    {groups.length === 0 ? (
      <p class="empty-state">
        暂无文章——请检查 Notion 数据库是否存在「状态=已发布」的文章。
      </p>
    ) : (
      <ArchiveTimeline groups={groups} />
    )}
  </main>
</BaseLayout>

<style>
  .archive-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  /* 归档头：丝带 ARCHIVE + 21:9 云隙画框 */
  .archive-head {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .archive-head h1 {
    font-size: 2.2rem;
    letter-spacing: 0.2em;
    color: #f4f5fa;
    text-shadow: 0 0 30px rgba(150, 180, 220, 0.3);
  }
  html.light .archive-head h1 {
    color: #2a3046;
    text-shadow: 0 1px 14px rgba(255, 255, 255, 0.7);
  }
  .archive-head-ribbon {
    margin-top: 1.2rem;
  }
  .archive-img {
    margin: 1.8rem auto 0;
    max-width: 560px;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: 2px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4);
  }
  .archive-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.85;
  }
  @media (max-width: 640px) {
    .archive-wrap {
      padding: 2rem 1.2rem 3rem;
    }
  }
</style>
