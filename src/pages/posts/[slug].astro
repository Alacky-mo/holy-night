---
import PostLayout from '../../layouts/PostLayout.astro';
import NotionBlocks from '../../components/astro/NotionBlocks.astro';
import { getAllPublishedPosts, getPostBySlug, type PostMeta } from '../../lib/notion';
import { blocksToPlainText } from '../../lib/notion-render';
import { estimateReadingTime } from '../../lib/utils';

// 遍历全部已发布文章生成静态路径（slug = Notion 页面 id）
export async function getStaticPaths() {
  const posts = await getAllPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
const detail = await getPostBySlug(post.slug);
const readingTime = detail
  ? estimateReadingTime(blocksToPlainText(detail.blocks))
  : 1;
---

<PostLayout post={post} readingTime={readingTime}>
  {
    detail ? (
      <NotionBlocks blocks={detail.blocks} />
    ) : (
      <p class="post-missing">正文加载失败，请稍后重新构建。</p>
    )
  }
</PostLayout>
