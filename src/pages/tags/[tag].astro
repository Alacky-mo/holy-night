---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/astro/PostCard.astro';
import { getAllPublishedPosts, type PostMeta } from '../../lib/notion';

// 从全部文章聚合出标签列表
export async function getStaticPaths() {
  const posts = await getAllPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: PostMeta[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag} · Holy Night`}>
  <main class="content">
    <h1>标签：{tag}</h1>
    <p class="page-count">共 {posts.length} 篇</p>
    {posts.length > 0 ? (
      <section class="post-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </section>
    ) : (
      <p class="empty-state">该标签下暂无文章</p>
    )}
  </main>
</BaseLayout>

<style>
  .page-count {
    color: var(--mist);
    font-family: var(--font-serif);
    font-size: 0.85rem;
  }
</style>
