---
import type { PostMeta } from '../../lib/notion';
import { formatDate } from '../../lib/utils';

interface Props {
  /** 归档分组：年份（降序）+ 该年文章（日期降序） */
  groups: { year: string; posts: PostMeta[] }[];
}

const { groups } = Astro.props;
---

<div class="archive-timeline">
  {groups.length === 0 ? (
    <p class="archive-empty">暂无文章</p>
  ) : (
    groups.map((group) => (
      <section key={group.year} class="archive-group">
        <h2 class="archive-year">{group.year}</h2>
        <ul class="archive-list">
          {group.posts.map((post) => (
            <li key={post.id} class="archive-item">
              <span class="archive-dot" aria-hidden="true"></span>
              {post.publishedAt && (
                <time class="archive-date" datetime={post.publishedAt}>
                  {formatDate(post.publishedAt).slice(5)}
                </time>
              )}
              <a class="archive-link" href={`/posts/${post.slug}`}>
                {post.title}
              </a>
              {post.category && <span class="archive-category">{post.category}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</div>

<style>
  .archive-timeline {
    position: relative;
    margin-top: 1.5rem;
  }
  .archive-group {
    position: relative;
    margin-bottom: 2.5rem;
    padding-left: 1.75rem;
  }
  /* 左侧金色竖向轴线 */
  .archive-group::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 0.4rem;
    bottom: -1rem;
    width: 1px;
    background: linear-gradient(
      180deg,
      var(--accent) 0%,
      rgba(212, 175, 55, 0.15) 100%
    );
  }
  .archive-year {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    color: var(--accent);
    text-shadow: 0 0 14px rgba(212, 175, 55, 0.25);
  }
  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .archive-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
  }
  /* 轴线上的节点圆点 */
  .archive-dot {
    position: absolute;
    left: -1.55rem;
    top: 0.95rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }
  .archive-date {
    flex: none;
    width: 3.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .archive-link {
    flex: 1;
    color: var(--text-primary);
    text-decoration: none;
  }
  .archive-link:hover {
    color: var(--accent);
  }
  .archive-category {
    flex: none;
    font-size: 0.75rem;
    color: var(--accent);
  }
  .archive-empty {
    color: var(--text-secondary);
  }
</style>
