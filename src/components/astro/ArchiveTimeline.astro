---
import type { PostMeta } from '../../lib/notion';
import { formatDate } from '../../lib/utils';

interface Props {
  /** 归档分组：年份（降序）+ 该年文章（日期降序） */
  groups: { year: string; posts: PostMeta[] }[];
}

const { groups } = Astro.props;
---

<div class="archive-timeline">
  {groups.length === 0 ? (
    <p class="archive-empty">暂无文章</p>
  ) : (
    groups.map((group) => (
      <section key={group.year} class="archive-group">
        <h2 class="tl-year">{group.year}</h2>
        <ul class="tl">
          {group.posts.map((post) => (
            <li key={post.id} class="tl-item">
              {post.publishedAt && (
                <time class="tl-date" datetime={post.publishedAt}>
                  {formatDate(post.publishedAt).slice(5)}
                </time>
              )}
              <a class="tl-link" href={`/posts/${post.slug}`}>
                {post.title}
              </a>
              {post.category && (
                <a class="cat tl-cat" href={`/categories/${post.category}`}>
                  {post.category}
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</div>

<style>
  .archive-timeline {
    margin-top: 1.5rem;
  }
  /* 年份：Cormorant 大字 + 琥珀发丝线 */
  .tl-year {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 2.4rem 0 1.2rem;
    font-family: var(--font-latin);
    font-size: 2rem;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  .tl-year::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(216, 168, 102, 0.4), transparent);
  }
  /* 左侧竖线 + 菱形节点（45° 方块） */
  .tl {
    list-style: none;
    border-left: 1px solid var(--hairline-strong);
    margin: 0 0 0 0.5rem;
    padding: 0 0 0 1.8rem;
  }
  .tl-item {
    position: relative;
    display: flex;
    gap: 1.4rem;
    align-items: baseline;
    padding: 0.55rem 0;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: -2.05rem;
    top: 1.15rem;
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: var(--night-1);
    border: 1px solid var(--silver-dim);
    transition: border-color 200ms ease-out, background-color 200ms ease-out;
  }
  .tl-item:hover::before {
    border-color: var(--amber);
    background: rgba(216, 168, 102, 0.3);
  }
  .tl-date {
    font-family: var(--font-latin);
    font-size: 0.95rem;
    color: var(--mist);
    white-space: nowrap;
    min-width: 3.4em;
  }
  .tl-link {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.02rem;
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .tl-link:hover {
    color: var(--amber-soft);
  }
  .tl-cat {
    margin-left: auto;
  }
  .archive-empty {
    color: var(--mist);
  }
  @media (max-width: 640px) {
    .tl-item {
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .tl-date {
      min-width: 3em;
    }
    .tl-cat {
      margin-left: auto;
    }
  }
</style>
