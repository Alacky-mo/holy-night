---
// 静态页码占位（无 JS 时链接到 ?page=N 也可跳转）；
// 实际的 ?page 内容切换由 PaginationSync.vue 岛屿接管（DONT_DO #9）
interface Props {
  totalPages: number;
  currentPage?: number;
  basePath?: string;
}

const { totalPages, currentPage = 1, basePath = '/' } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const pageHref = (p: number): string =>
  p === 1 ? basePath : `${basePath}?page=${p}`;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="分页">
      <span class="pagination-pages">
        {pages.map((p) => (
          <a
            class:list={['pagination-link', { current: p === currentPage }]}
            href={pageHref(p)}
            data-page={p}
            aria-current={p === currentPage ? 'page' : undefined}
          >
            {p}
          </a>
        ))}
      </span>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0;
  }
  .pagination-pages {
    display: flex;
    gap: 0.5rem;
  }
  .pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.85rem;
    /* 其余页码灰蓝 */
    color: var(--text-secondary);
    text-decoration: none;
  }
  .pagination-link:hover {
    color: var(--accent);
    border-color: var(--border);
  }
  /* 当前页金色高亮 */
  .pagination-link.current {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(212, 175, 55, 0.12);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
  }
</style>
