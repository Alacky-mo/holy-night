---
import type { PostMeta } from '../../lib/notion';
import { formatDate } from '../../lib/utils';

interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
---

<article class="post-card">
  {post.cover && (
    <a class="post-card-cover-link" href={`/posts/${post.slug}`} aria-label={post.title}>
      <img
        class="post-card-cover"
        src={post.cover}
        alt={post.title}
        width="1200"
        height="675"
        loading="lazy"
      />
    </a>
  )}
  <div class="post-card-body">
    <h2 class="post-card-title">
      <a href={`/posts/${post.slug}`}>{post.title}</a>
    </h2>
    {post.excerpt && <p class="post-card-excerpt">{post.excerpt}</p>}
    <div class="post-card-meta">
      {post.publishedAt && (
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      )}
      {post.category && (
        <a class="post-card-category" href={`/categories/${post.category}`}>
          {post.category}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 圆角 10px + 1px 金色半透明内描边 + 半透明背景模糊（AGENT.md 5.4） */
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  /* hover 上浮 2px + 金色光晕扩散 */
  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 0 22px rgba(212, 175, 55, 0.28);
  }
  .post-card-cover-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* 图片加载前的底色占位 */
    background: rgba(128, 128, 128, 0.12);
  }
  .post-card-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }
  .post-card:hover .post-card-cover {
    transform: scale(1.03);
  }
  .post-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.2rem 1.4rem;
  }
  .post-card-title {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }
  .post-card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .post-card-title a:hover {
    color: var(--accent);
  }
  .post-card-excerpt {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card-meta {
    margin-top: auto;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .post-card-category {
    color: var(--accent);
    text-decoration: none;
  }
  .post-card-category:hover {
    color: var(--accent-warm);
  }
</style>
