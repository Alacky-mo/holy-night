---
import type { PostMeta } from '../../lib/notion';
import { formatDate } from '../../lib/utils';

interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
---

<article class="post-card">
  {post.cover ? (
    <a class="post-card-cover" href={`/posts/${post.slug}`} aria-label={post.title}>
      <img
        src={post.cover}
        alt={post.title}
        width="1200"
        height="675"
        loading="lazy"
      />
    </a>
  ) : (
    /* 无封面：馆中未挂上的画框（内嵌细边 + 中央四角星） */
    <a class="post-card-cover empty" href={`/posts/${post.slug}`} aria-label={post.title}>
      <svg class="star" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0c.7 5.3 2.7 7.3 12 8-9.3.7-11.3 2.7-12 8-.7-5.3-2.7-7.3-12-8C9.3 7.3 11.3.7 12 0z" />
      </svg>
    </a>
  )}
  <div class="post-card-body">
    <h2 class="post-card-title">
      <a href={`/posts/${post.slug}`}>{post.title}</a>
    </h2>
    {post.excerpt && <p class="post-card-excerpt">{post.excerpt}</p>}
    <div class="post-card-meta">
      {post.publishedAt && (
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      )}
      {post.category && (
        <a class="cat" href={`/categories/${post.category}`}>
          {post.category}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* 画框卡：3px 圆角 + 1px 银白发丝细边 + 玻璃底（AGENT.md 5.4） */
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 3px;
    border: 1px solid var(--hairline);
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: transform 250ms ease-out, border-color 250ms ease-out,
      box-shadow 250ms ease-out, background-color 250ms ease-out;
  }
  /* hover 上浮 2px + 边框转琥珀 + 极淡琥珀外发光（烛光） */
  .post-card:hover {
    transform: translateY(-2px);
    border-color: rgba(216, 168, 102, 0.55);
    box-shadow:
      0 10px 34px rgba(0, 0, 0, 0.4),
      0 0 22px rgba(216, 168, 102, 0.1);
  }
  .post-card-cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #141a2c;
  }
  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease-out;
  }
  .post-card:hover .post-card-cover img {
    transform: scale(1.03);
  }
  /* 空画框：深色底 + 内嵌 14px 细边 + 中央四角星 */
  .post-card-cover.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, #171f36, #101527);
    position: relative;
  }
  .post-card-cover.empty::before {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(231, 233, 242, 0.14);
  }
  .post-card-cover.empty .star {
    width: 34px;
    height: 34px;
    color: rgba(231, 233, 242, 0.3);
  }
  html.light .post-card-cover {
    background: #e8e2d4;
  }
  html.light .post-card-cover.empty {
    background: linear-gradient(160deg, #ece6d8, #e0d9c9);
  }
  html.light .post-card-cover.empty::before {
    border-color: rgba(80, 70, 55, 0.18);
  }
  html.light .post-card-cover.empty .star {
    color: rgba(80, 70, 55, 0.3);
  }
  .post-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.4rem 1.35rem;
  }
  .post-card-title {
    margin: 0 0 0.55rem;
    font-size: 1.18rem;
    line-height: 1.45;
  }
  .post-card-title a {
    color: var(--silver);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .post-card-title a:hover {
    color: var(--amber-soft);
  }
  .post-card-excerpt {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--mist);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card-meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--mist);
  }
</style>
