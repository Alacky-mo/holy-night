---
import BaseLayout from './BaseLayout.astro';
import PostToc from '../components/vue/PostToc.vue';
import PostPrevNext from '../components/astro/PostPrevNext.astro';
import type { PostMeta } from '../lib/notion';
import type { TocItem } from '../lib/notion-render';
import { formatDate } from '../lib/utils';

interface Props {
  post: PostMeta;
  readingTime: number;
  headings: TocItem[];
  prev: PostMeta | null;
  next: PostMeta | null;
}

const { post, readingTime, headings, prev, next } = Astro.props;
---

<BaseLayout
  title={`${post.title} · Holy Night`}
  description={post.excerpt || post.title}
  ogImage={post.cover}
  ogType="article"
  canonicalPath={`/posts/${post.slug}`}
>
  <main class="content post-layout">
    <div class:list={['post-shell', { 'has-toc': headings.length > 0 }]}>
      <article class="post-article">
        <header class="post-header">
          <h1 class="post-title">{post.title}</h1>
          <div class="post-meta">
            {post.publishedAt && (
              <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            )}
            {post.category && (
              <a class="post-category" href={`/categories/${post.category}`}>
                {post.category}
              </a>
            )}
            <span class="post-reading-time">约 {readingTime} 分钟</span>
          </div>
          {post.tags.length > 0 && (
            <div class="post-tags">
              {post.tags.map((tag) => (
                <a key={tag} class="post-tag" href={`/tags/${tag}`}>
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="post-body">
          <slot />
        </div>

        <PostPrevNext prev={prev} next={next} />
      </article>

      {headings.length > 0 && (
        <aside class="post-aside">
          <PostToc headings={headings} client:load />
        </aside>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .post-layout {
    margin-top: 2rem;
  }
  /* 移动端/平板：单列，目录走悬浮按钮 */
  .post-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-title {
    margin: 0 0 1rem;
    font-size: 2.1rem;
    line-height: 1.3;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .post-category,
  .post-tag {
    color: var(--accent);
    text-decoration: none;
  }
  .post-category:hover,
  .post-tag:hover {
    color: var(--accent-warm);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
  }
  .post-body {
    max-width: 800px;
  }

  /* 桌面端：正文 800px + 右侧 240px 目录，整体居中 */
  @media (min-width: 1025px) {
    .post-shell.has-toc {
      grid-template-columns: minmax(0, 800px) 240px;
      gap: 3rem;
      justify-content: center;
    }
    .post-aside {
      position: sticky;
      top: 5rem;
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }
</style>
