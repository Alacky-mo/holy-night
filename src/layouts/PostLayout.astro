---
import BaseLayout from './BaseLayout.astro';
import type { PostMeta } from '../lib/notion';
import { formatDate } from '../lib/utils';

interface Props {
  post: PostMeta;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
---

<BaseLayout title={`${post.title} · Holy Night`} description={post.excerpt}>
  <article class="content post-layout">
    <header class="post-header">
      <h1 class="post-title">{post.title}</h1>
      <div class="post-meta">
        {post.publishedAt && (
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        )}
        {post.category && (
          <a class="post-category" href={`/categories/${post.category}`}>
            {post.category}
          </a>
        )}
        <span class="post-reading-time">约 {readingTime} 分钟</span>
      </div>
      {post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map((tag) => (
            <a key={tag} class="post-tag" href={`/tags/${tag}`}>
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-layout {
    margin-top: 2rem;
  }
  .post-header {
    max-width: 800px;
    margin: 0 auto 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-title {
    margin: 0 0 1rem;
    font-size: 2.1rem;
    line-height: 1.3;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .post-category,
  .post-tag {
    color: var(--accent);
    text-decoration: none;
  }
  .post-category:hover,
  .post-tag:hover {
    color: var(--accent-warm);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
  }
  /* 正文阅读列：不超过 1200px 内容区，单列阅读宽度 800px */
  .post-body {
    max-width: 800px;
    margin-inline: auto;
  }
</style>
