---
import '../styles/global.css';
import '../styles/markdown.css';
import NavBar from '../components/astro/NavBar.astro';
import Footer from '../components/astro/Footer.astro';
import BackToTop from '../components/vue/BackToTop.vue';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Holy Night',
  description = '个人内容创作博客 · 杂文 / 书评 / 影评',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- 标题：Noto Serif SC / Playfair Display；正文：Noto Sans SC（Google Fonts 自动按 unicode-range 分片）
         非阻塞加载：preload 样式表 + onload 切换，避免字体 CSS 阻塞首屏渲染（LCP）；
         配合 display=swap，先用系统衬线/无衬线渲染，字体到位后再替换。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=Playfair+Display:wght@400;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=Playfair+Display:wght@400;600&display=swap"
      />
    </noscript>

    <!-- 主题初始化脚本（防 FOUC）：在首次绘制前恢复 localStorage 中的主题 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          /* localStorage 不可用时静默忽略，保持默认深色主题 */
        }
      })();
    </script>
  </head>
  <body>
    <NavBar />
    <slot />
    <Footer />
    <BackToTop client:load />
  </body>
</html>
