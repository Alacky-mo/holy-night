---
import '../styles/global.css';
import '../styles/markdown.css';
import NavBar from '../components/astro/NavBar.astro';
import Footer from '../components/astro/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Holy Night',
  description = '个人内容创作博客 · 杂文 / 书评 / 影评',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- 标题：Noto Serif SC / Playfair Display；正文：Noto Sans SC（Google Fonts 自动按 unicode-range 分片） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- 主题初始化脚本（防 FOUC）：在首次绘制前恢复 localStorage 中的主题 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          /* localStorage 不可用时静默忽略，保持默认深色主题 */
        }
      })();
    </script>
  </head>
  <body>
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>
