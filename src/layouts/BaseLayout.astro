---
import '../styles/global.css';
import '../styles/markdown.css';
import NavBar from '../components/astro/NavBar.astro';
import Footer from '../components/astro/Footer.astro';
import BackToTop from '../components/vue/BackToTop.vue';

interface Props {
  /** 页面 title；缺省用站点名 */
  title?: string;
  /** 页面 description；缺省用站点简介 */
  description?: string;
  /** Open Graph 图片：相对路径（/images/...）或绝对 URL；缺省用站点名 */
  ogImage?: string | null;
  /** og:type：文章页传 article，其余默认 website */
  ogType?: 'website' | 'article';
  /** 当前页规范 URL（相对路径，如 /posts/xxx），缺省不输出 canonical */
  canonicalPath?: string;
  /** 页面视图语义：决定固定背景与遮罩（阶段 5「双世界」） */
  view?: 'home' | 'archive' | 'post' | 'default';
}

const {
  title = 'Holy Night',
  description = '个人内容创作博客 · 杂文 / 书评 / 影评',
  ogImage = null,
  ogType = 'website',
  canonicalPath,
  view = 'default',
} = Astro.props;

// Astro.site 来自 astro.config.mjs 的 site 字段；OG 图/canonical 需要绝对 URL
const site = Astro.site;
const absOgImage = ogImage
  ? /^https?:\/\//.test(ogImage)
    ? ogImage
    : new URL(ogImage, site).toString()
  : null;
const canonical = canonicalPath ? new URL(canonicalPath, site).toString() : null;
const siteName = 'Holy Night';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Twitter Card（微信、Twitter 等分享预览依赖） -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {absOgImage && <meta property="og:image" content={absOgImage} />}
    <meta name="twitter:card" content={absOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absOgImage && <meta name="twitter:image" content={absOgImage} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>

    <!-- 标题：Noto Serif SC / 西文与丝带：Cormorant Garamond；正文：Noto Sans SC（Google Fonts 自动按 unicode-range 分片）
         非阻塞加载：preload 样式表 + onload 切换，避免字体 CSS 阻塞首屏渲染（LCP）；
         配合 display=swap，先用系统衬线/无衬线渲染，字体到位后再替换。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap"
      />
    </noscript>

    <!-- 主题初始化脚本（防 FOUC）：在首次绘制前恢复 localStorage 中的主题 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          /* localStorage 不可用时静默忽略，保持默认深色主题 */
        }
      })();
    </script>
  </head>
  <body data-view={view}>
    <!-- 固定背景三层：原画局部 + 遮罩 + 颗粒（阶段 5），按 data-view 切换 -->
    <div class="bg-layer" aria-hidden="true"></div>
    <div class="bg-scrim" aria-hidden="true"></div>
    <div class="bg-grain" aria-hidden="true"></div>
    <NavBar />
    <slot />
    <Footer />
    <BackToTop client:load />
  </body>
</html>
